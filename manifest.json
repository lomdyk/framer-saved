{
  "manifest_version": 3,
  "name": "Framer Saved Components & Favorites",
  "version": "1.2.0",
  "description": "Adds a native Saved/Favorites tab to Framer Marketplace sidebar, bookmark buttons, and one-click Live Preview export (HTML/CSS/JS ZIP).",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://www.framer.com/*",
    "https://*.framer.website/*",
    "https://*.framer.app/*",
    "https://*.framer.ai/*",
    "https://framerusercontent.com/*",
    "https://*.public.blob.vercel-storage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.framer.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Framer Saved Components",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendor/jszip.min.js"],
      "matches": ["https://www.framer.com/*", "https://*.framer.website/*", "https://*.framer.app/*", "https://*.framer.ai/*"]
    }
  ]
}
